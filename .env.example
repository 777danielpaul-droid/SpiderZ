# ── Supabase (Client, öffentlich) ───────────────────────────────
# Aus dem Supabase-Dashboard: Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Nur für das Seed-Skript (scripts/seed.mjs) ───────────────────
# Service-Role-Key hat Schreibrechte (Bilder + Daten füllen).
# NIEMALS ins Repo committen, NIEMALS im Browser/Client verwenden!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
